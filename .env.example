# ==============================================================================
# CashFlow Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Provider Switching
# ------------------------------------------------------------------------------
# Allowed values: 'sqlite' (development) or 'd1' (production)
DATABASE_PROVIDER=sqlite

# --- For Local SQLite Development (DATABASE_PROVIDER=sqlite) ---
# Relative to backend/prisma: file:../../data/dev.db
DATABASE_URL="file:../../data/dev.db"

# --- For Cloudflare D1 Production (DATABASE_PROVIDER=d1) ---
# Required in production: Cloudflare account, D1 database ID, and API token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_d1_database_uuid
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_d1_permissions

# Optional custom worker or proxy endpoint (if querying D1 via custom gateway)
# CLOUDFLARE_D1_HTTP_URL=https://d1-proxy.your-subdomain.workers.dev

# Automatically run schema migrations on container startup (true/false)
AUTO_MIGRATE=true

# ------------------------------------------------------------------------------
# 2. Server & Port Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development

# Public application port (Next.js Frontend & API BFF proxy)
PORT=3000

# Internal backend port (NestJS server - kept private to container loopback in production)
BACKEND_PORT=4000

# Loopback proxy URL used by Next.js to communicate with NestJS internally
INTERNAL_BACKEND_URL=http://127.0.0.1:4000

# Frontend URL (used by backend for CORS validation)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Authentication & Security (Keep Secret!)
# ------------------------------------------------------------------------------
# Minimum 32-character random string for signing JWT tokens
JWT_SECRET=replace_with_a_long_random_secure_jwt_secret_string_32_chars_min
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. Object Storage (Reserved for Future Extensions)
# ------------------------------------------------------------------------------
# Note: Cloudflare R2 integration is reserved for future file uploads/attachments.
# Not required for current CashFlow transactional/expense operations.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=cashflow-storage

# ------------------------------------------------------------------------------
# 5. Docker Hub CI/CD (Configured in GitHub Repository Secrets)
# ------------------------------------------------------------------------------
# DOCKERHUB_USERNAME=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_personal_access_token
