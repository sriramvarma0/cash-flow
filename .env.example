# Server Configuration
PORT=4000
NODE_ENV=development

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Database URL
# In local development: file:../../data/dev.db (Prisma relative)
# In production: file:/var/lib/cashflow/cashflow.db
DATABASE_URL=file:../../data/dev.db

# Frontend URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# AWS S3 Backups (used by deployment/backup scripts)
S3_BACKUP_BUCKET=your-private-s3-backup-bucket-name
S3_BACKUP_PREFIX=cashflow
