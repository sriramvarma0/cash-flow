generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  name                   String
  email                  String                  @unique
  phoneNumber            String                  @unique
  passwordHash           String
  twoFactorEnabled       Boolean                 @default(false)
  twoFactorSecret        String?
  twoFactorTempSecret    String?
  twoFactorRecoveryCodes String?
  failedLoginAttempts    Int                     @default(0)
  lockoutUntil           DateTime?
  createdAt              DateTime                @default(now())
  expenses               Expense[]               @relation("ExpenseOwner")
  receivedTransfers      Expense[]               @relation("TransferRecipient")
  ownedGroups            Group[]                 @relation("GroupOwner")
  memberGroups           Group[]                 @relation("GroupMembers")
  tags                   Tag[]
  investments            Investment[]            @relation("UserInvestments")
  investmentTransactions InvestmentTransaction[] @relation("UserInvestmentTransactions")
}

model Expense {
  id              String   @id @default(cuid())
  amount          Float
  category        String?
  description     String?
  paymentMethod   String   @default("Card")
  paymentAccount  String?
  date            DateTime
  createdAt       DateTime @default(now())
  userId          String
  user            User     @relation("ExpenseOwner", fields: [userId], references: [id], onDelete: Cascade)
  transactionType String   @default("EXPENSE") // EXPENSE, INCOME, TRANSFER
  toUserId        String?
  toUser          User?    @relation("TransferRecipient", fields: [toUserId], references: [id], onDelete: SetNull)
  tags            Tag[]
  categoryType    String?
  isReceivable    Boolean  @default(false)
  receivableStatus String?  @default("OUTSTANDING") // OUTSTANDING, PARTIALLY_SETTLED, SETTLED
  reimbursedAmount Float?   @default(0)

  @@index([userId, date])
  @@index([userId, category])
  @@index([userId, categoryType])
  @@index([userId, transactionType])
  @@index([userId, isReceivable])
}

model Group {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  ownerId     String
  owner       User         @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     User[]       @relation("GroupMembers")
  invitations Invitation[]
  adminIds    String       @default("[]")
}

model Invitation {
  id           String   @id @default(cuid())
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviteeEmail String?
  inviteePhone String?
  status       String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt    DateTime @default(now())

  @@index([inviteeEmail])
  @@index([inviteePhone])
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([name, userId])
}

model Investment {
  id           String                  @id @default(cuid())
  code         String                  @default("") // Symbol or ticker code, e.g. AAPL, BTC-USD, RELIANCE.NS
  name         String
  type         String                  // Stock, Mutual Fund, ETF, Crypto, Gold, Real Estate
  units        Float
  buyPrice     Float
  currentPrice Float
  color        String
  date         DateTime                @default(now())
  userId       String
  user         User                    @relation("UserInvestments", fields: [userId], references: [id], onDelete: Cascade)
  transactions InvestmentTransaction[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([userId])
}

model InvestmentTransaction {
  id           String     @id // PB... or PS...
  type         String     @default("BUY") // BUY or SELL
  units        Float
  price        Float
  amount       Float
  date         DateTime   @default(now())
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("UserInvestmentTransactions", fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([investmentId])
  @@index([userId])
}

