PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=file:./dev.db
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Email Provider Configuration (Provider-independent transactional email system)
# ------------------------------------------------------------------------------
# Active email provider: 'gmail' or 'resend'
EMAIL_PROVIDER=resend

# --- Option A: Google Gmail API (EMAIL_PROVIDER=gmail) ---
# Requires OAuth2 credentials from Google Cloud Console with scope:
# https://www.googleapis.com/auth/gmail.send
GMAIL_USER=your_email@gmail.com
GMAIL_CLIENT_ID=your_oauth2_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_oauth2_client_secret
GMAIL_REFRESH_TOKEN=your_oauth2_refresh_token

# --- Option B: Resend API (EMAIL_PROVIDER=resend) ---
# Requires API key from resend.com and a verified sending domain
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="CashFlow <notifications@yourverifieddomain.com>"

# Optional request timeout in milliseconds (default: 10000ms = 10s)
EMAIL_REQUEST_TIMEOUT_MS=10000
